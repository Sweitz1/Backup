# Copy to .env and fill in. Both the app and docker-compose read it.

# Auth.js — generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated Google accounts allowed to sign in. Empty = nobody can sign in.
ALLOWED_EMAILS=you@gmail.com

# Local model server (Ollama)
OLLAMA_HOST=http://127.0.0.1:11434
DEFAULT_MODEL=llama3.1

# Optional: where skill folders live (default: ./skills)
# SKILLS_DIR=./skills

# --- Tools (used by skills that list them) ---
# web_fetch makes outbound requests to the sites the model chooses, so it's off unless set to true.
# It can never reach this machine or your local network.
ENABLE_WEB_FETCH=false

# web_search uses your self-hosted SearXNG (started by docker-compose). Leave empty to turn it off.
SEARXNG_URL=http://127.0.0.1:8080
# Used by docker-compose for SearXNG. Generate with: openssl rand -hex 32
SEARXNG_SECRET=

# The only folder list_files / read_file can see (default: ./data/files)
# FILES_DIR=./data/files
