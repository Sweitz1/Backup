# Copy to .env.local and fill in.

# Auth.js — generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated Google accounts allowed to sign in. Empty = nobody can sign in.
ALLOWED_EMAILS=you@gmail.com

# Local model server (Ollama)
OLLAMA_HOST=http://127.0.0.1:11434
DEFAULT_MODEL=llama3.1

# Optional: where skill folders live (default: ./skills)
# SKILLS_DIR=./skills
