<?xml version="1.0" encoding="utf-8"?>
<!-- One eye's view of the menu: settings toggles followed by the model list. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:orientation="vertical"
    android:paddingStart="36dp"
    android:paddingTop="28dp"
    android:paddingEnd="36dp"
    android:paddingBottom="20dp">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/picker_title"
        android:textColor="@color/accent"
        android:textSize="16sp" />

    <!-- Rows are added in code: a fixed window of items around the focused one. -->
    <LinearLayout
        android:id="@+id/rows"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/tvHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/picker_hint"
        android:textColor="@color/muted"
        android:textSize="12sp" />
</LinearLayout>
